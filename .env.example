# Copy this file to .env and fill in your values

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Google Vertex AI (Gemini + Veo 2) ─────────────────────────────────────────
# Your Google Cloud project ID
GOOGLE_PROJECT_ID=

# Vertex AI region (Veo 2 available in us-central1)
GOOGLE_LOCATION=

# Auth: run 'gcloud auth application-default login' before starting the server
# OR point to a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Supabase (Auth + Database) ────────────────────────────────────────────────
# Get from https://supabase.com → Project Settings → API
# These are VITE_ prefixed so they are available in the browser bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

GROQ_API_KEY=